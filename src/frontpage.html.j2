<header>
  <center>
  <img src="data:image/svg+xml;base64,"  width="90%" class="msmt-header" />
  </center>
  <h1>{{ ctx.questionnaire.name }}</h1>





  <div class="info">
    <h3>
    Data Management Plan
  </h3>


    <div class="version-info">
        {%  if dc.project.versions %}
            {% set version = dc.project.versions[-1] %}
            <div class="version">{{version.name}}</div>
        {% else  %}
            <div class="version">NO VERSION</div>
        {% endif %}

      <div class="date">{{ dc.doc.created_at|datetime_format("%d %B %Y") }}</div>


    </div>



    <p class="note">
        Data Management Plan created in <a href="https://ds-wizard.org/" target="_blank"> Data Stewardship Wizard</a>. Corresponds with Horizon Europe DMP template.
    </p>
  </div>
</header>
